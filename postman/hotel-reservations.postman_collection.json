  "item": [
    {
      "name": "00 Setup: room type Double (cap 2, 300.00)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/room-types",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "room-types"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Double-{{runId}}\",\n  \"capacity\": 2,\n  \"pricePerNight\": 300.00\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const pad = n => String(n).padStart(2, '0');",
              "const fmt = d => `${d.getUTCFullYear()}-${pad(d.getUTCMonth() + 1)}-${pad(d.getUTCDate())}`;",
              "const plus = days => { const d = new Date(); d.setUTCDate(d.getUTCDate() + days); return fmt(d); };",
              "",
              "const runId = Date.now().toString(36);",
              "pm.collectionVariables.set('runId', runId);",
              "pm.collectionVariables.set('d30', plus(30));",
              "pm.collectionVariables.set('d31', plus(31));",
              "pm.collectionVariables.set('d33', plus(33));",
              "pm.collectionVariables.set('d35', plus(35));",
              "pm.collectionVariables.set('d61', plus(61));",
              "pm.collectionVariables.set('past', plus(-2));",
              "pm.collectionVariables.set('roomANumber', Math.floor(Math.random() * 900000) + 100000);",
              "pm.collectionVariables.set('roomBNumber', Math.floor(Math.random() * 900000) + 100000);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 201', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('doubleTypeId', pm.response.json().id);"
            ]
          }
        }
      ]
    },
