    {
      "name": "R1 Valid reservation -> 201, price = 3 x 300",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/reservations",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "reservations"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"roomId\": \"{{roomAId}}\",\n  \"guestFirstName\": \"Jan\",\n  \"guestLastName\": \"Kowalski\",\n  \"guestEmail\": \"Jan.{{runId}}@Example.com\",\n  \"checkIn\": \"{{d30}}\",\n  \"checkOut\": \"{{d33}}\",\n  \"guestCount\": 2\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 201', () => pm.response.to.have.status(201));",
              "const r = pm.response.json();",
              "pm.test('totalPrice = 900', () => pm.expect(Number(r.totalPrice)).to.eql(900));",
              "pm.test('status CONFIRMED', () => pm.expect(r.status).to.eql('CONFIRMED'));",
              "pm.test('guest has first and last name', () => {",
              "  pm.expect(r.guest.firstName).to.eql('Jan');",
              "  pm.expect(r.guest.lastName).to.eql('Kowalski');",
              "});",
              "pm.test('email normalized to lower case', () => pm.expect(r.guest.email).to.eql(r.guest.email.toLowerCase()));",
              "pm.test('room type is nested', () => pm.expect(r.room.roomType.id).to.eql(pm.collectionVariables.get('doubleTypeId')));",
              "pm.collectionVariables.set('guestId', r.guest.id);",
              "pm.collectionVariables.set('reservation1Id', r.id);"
            ]
          }
        }
      ]
    },
